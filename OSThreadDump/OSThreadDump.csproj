<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Single exe that uses the .NET 8 runtime installed on the server
    (OutSystems Platform Server 11.27+ installs it with the .NET 8 Hosting Bundle):
      dotnet publish OSThreadDump/OSThreadDump.csproj -c Release -r win-x64 -o dist
      dotnet publish OSThreadDump/OSThreadDump.csproj -c Release -r win-x86 -o dist
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>OSThreadDump</RootNamespace>
    <AssemblyName>OSThreadDump</AssemblyName>
    <AssemblyName Condition="'$(RuntimeIdentifier)' == 'win-x86'">OSThreadDump.x86</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Windows-only tool; silence "only supported on Windows" analyzer warnings. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>

    <Version>2.0.0</Version>
    <Product>OSThreadDump</Product>
    <Description>Dumps managed thread stacks of .NET processes with OS thread IDs and CPU time.</Description>
    <Copyright>Copyright © 2017-2026</Copyright>
  </PropertyGroup>

  <!-- Publishing for a runtime (-r win-x64 / win-x86): one framework-dependent exe. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Runtime" Version="3.1.512801" />
  </ItemGroup>

</Project>
