<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>OSThreadDump</RootNamespace>
    <AssemblyName>OSThreadDump</AssemblyName>
    <!-- Build the 32-bit variant with: dotnet build -c Release -p:PlatformTarget=x86 -->
    <PlatformTarget Condition="'$(PlatformTarget)' == ''">AnyCPU</PlatformTarget>
    <AssemblyName Condition="'$(PlatformTarget)' == 'x86'">OSThreadDump.x86</AssemblyName>
    <Prefer32Bit>false</Prefer32Bit>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>

    <Version>2.0.0</Version>
    <Product>OSThreadDump</Product>
    <Description>Dumps managed thread stacks of .NET processes with OS thread IDs and CPU time.</Description>
    <Copyright>Copyright © 2017-2026</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Runtime" Version="3.1.512801" />
  </ItemGroup>

</Project>
